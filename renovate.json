{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "automergeType": "pr",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rmcrackan/Libation",
      "managerFilePatterns": [
        "recipes/recipe-*.yml"
      ],
      "matchStrings": [
        "download/(?<currentVersion>.*?)/Libation.(?<currentValue>.*?)-linux"
      ],
      "autoReplaceStringTemplate": "download/v{{{newValue}}}/Libation.{{{newValue}}}-linux"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jgraph/drawio-desktop",
      "managerFilePatterns": [
        "recipes/recipe-*.yml"
      ],
      "matchStrings": [
        "download/(?<currentVersion>.*?)/drawio-x86_64.(?<currentValue>.*?)"
      ],
      "autoReplaceStringTemplate": "download/v{{{newValue}}}/drawio-x86_64.{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "rmcrackan/Libation",
        "jgraph/drawio-desktop"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
